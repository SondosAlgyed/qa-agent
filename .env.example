# Jira Cloud
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-api-token

# Anthropic API - only if qa.config.ts uses llm.type "claude".
# With llm.type "claude-code", qa uses your Claude Code login instead (no key needed).
# ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI (GPT) - only for the G-Eval judge in evals/
OPENAI_API_KEY=your-openai-api-key
